# ============================================
# AgilDoc - Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores

# === BANCO DE DADOS ===
DATABASE_URL="postgresql://agildoc_user:senha_segura@localhost:5432/agildoc_db"

# === SERVIDOR ===
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# === JWT ===
JWT_SECRET=sua_chave_jwt_muito_secreta_aqui_min_32_chars
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=sua_chave_refresh_muito_secreta_aqui
JWT_REFRESH_EXPIRES_IN=7d

# === GOV.BR OAuth2 ===
GOVBR_CLIENT_ID=seu_client_id_govbr
GOVBR_CLIENT_SECRET=seu_client_secret_govbr
GOVBR_REDIRECT_URI=http://localhost:3001/api/auth/govbr/callback
GOVBR_AUTH_URL=https://sso.acesso.gov.br/authorize
GOVBR_TOKEN_URL=https://sso.acesso.gov.br/token
GOVBR_USERINFO_URL=https://sso.acesso.gov.br/userinfo

# === EMAIL (SMTP) ===
SMTP_HOST=smtp.uol.com.br
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@agildoc.com.br
SMTP_PASS=sua_senha_smtp
EMAIL_FROM="AgilDoc <noreply@agildoc.com.br>"

# === UPLOAD DE ARQUIVOS ===
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# === ASSINATURA DIGITAL ===
SIGNATURE_PROVIDER=govbr
VIDAAS_API_URL=https://certificado.vidaas.com.br/valid/api/v1

# === SISTEMA ===
ORG_NAME="Prefeitura Municipal de Exemplo"
ORG_CNPJ=00.000.000/0001-00
ORG_LOGO_URL=
SYSTEM_VERSION=1.0.0
